{
	"luci-app-wrt-hotspot": {
		"description": "Grant access to the WrtHotspot captive portal",
		"read": {
			"ubus": {
				"luci-rpc": [ "getDHCPLeases" ],
				"wrthotspot": [ "status", "sessions", "active", "hosts", "cookies", "user_list", "user_get", "user_password", "check",
					"pages_list", "pages_files", "pages_read" ]
			},
			"uci": [ "wrthotspot", "network", "firewall", "dhcp" ]
		},
		"write": {
			"ubus": {
				"wrthotspot": [ "logout", "user_set", "user_remove", "user_reset_counters", "cookie_remove", "reload", "flush", "setup",
					"pages_begin", "pages_put", "pages_commit", "pages_remove" ]
			},
			"uci": [ "wrthotspot" ]
		}
	}
}

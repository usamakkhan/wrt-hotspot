#!/usr/bin/ucode -S
// hotspotd: control-plane daemon for the WrtHotspot captive portal.
'use strict';

import * as uloop from 'uloop';
import * as ubus from 'ubus';
import * as core_mod from 'wrthotspot.core';
import * as api from 'wrthotspot.api';
import { writefile } from 'fs';
import { log } from 'wrthotspot.util';

// Under memory pressure the kernel should pick a portal worker or a tool,
// not the process that holds every session (found in the load tests).
writefile('/proc/self/oom_score_adj', '-500');

uloop.init();

let conn = ubus.connect();
if (!conn) {
	log('error', 'Cannot connect to ubus: %s', ubus.error());
	exit(1);
}

let core = core_mod.create({ ubus: conn });
let err = core.start();

if (err)
	log('error', 'Initial dataplane build failed: %s (will retry)', err);

let obj = api.publish(conn, core);
if (!obj) {
	log('error', 'Cannot publish ubus object: %s', ubus.error());
	exit(1);
}

let cfg = core.config();

// An exception escaping a uloop callback ends uloop and with it the daemon:
// every callback goes through here.
function guard(what, fn) {
	try {
		return fn();
	}
	catch (e) {
		log('error', '%s: %s\n%s', what, e.message, e.stacktrace?.[0]?.context ?? '');
	}
}

let poll, sync, resolve;

poll = uloop.timer(cfg.global.poll_interval * 1000, function() {
	guard('poll', () => core.poll());

	// Each poll builds large temporary strings (counter dumps, checkpoint);
	// collect them now instead of letting the heap grow between cycles.
	gc('collect');

	poll.set(core.config().global.poll_interval * 1000);
});

sync = uloop.timer(cfg.global.db_sync_interval * 1000, function() {
	guard('db sync', () => core.sync_db());
	sync.set(core.config().global.db_sync_interval * 1000);
});

// Keep walled-garden host sets fresh (essential without dnsmasq-full).
resolve = uloop.timer(cfg.global.resolve_interval * 1000, function() {
	guard('walled garden resolve', () => core.resolve());
	resolve.set(core.config().global.resolve_interval * 1000);
});

// Re-resolve devices when the hotspot networks go up/down.
let iface_listener = conn.listener('network.interface', function(type, data) {
	let srvs = core.config().servers;

	for (let name, s in srvs) {
		if (s.interface == data?.interface) {
			guard('reload', () => core.reload());
			break;
		}
	}
});

// uloop itself ends the loop on SIGTERM/SIGINT; SIGHUP reloads the config.
// A client that resets a connection (RouterOS API) must not kill us with SIGPIPE.
if (uloop.signal) {
	uloop.signal('HUP', () => guard('reload', () => core.reload()));
	uloop.signal('PIPE', () => null);
}

log('info', 'hotspotd %s started', core_mod.VERSION);
uloop.run();

// Unpublish first: while state is saved, callers (portal, LuCI, a new
// instance's clients) get "not found" at once instead of a 30 s timeout.
obj.remove();
core.stop();
log('info', 'hotspotd stopped');

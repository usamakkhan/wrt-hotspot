#!/usr/bin/ucode -S
// wrthotspot: command line front-end for hotspotd.
'use strict';

import * as fs from 'fs';
import * as ubus from 'ubus';
import { cursor } from 'uci';
import { fmt_duration, fmt_bytes, run } from 'wrthotspot.util';
import { run_checks } from 'wrthotspot.diag';
import { load as load_config, parse_proxy } from 'wrthotspot.config';
import { remove_dnsmasq, remove_odhcpd } from 'wrthotspot.dns';

const USAGE = `Usage: wrthotspot <command> [args]

  status                      daemon status
  sessions                    active sessions
  hosts                       hosts seen on hotspot interfaces
  users                       local users
  user add <name> [k=v ...]   create/update a user (password=, profile=, mac=,
                              limit_uptime=, limit_bytes_total=, server=, ...)
  user set <name> [k=v ...]   same as add
  user del <name>             delete a user (and log out its sessions)
  user reset <name>           reset a user's usage counters
  logout <ip|mac|user|id>     log out matching sessions
  cookies                     HTTP and MAC cookies
  cookie del <mac|user>       remove cookies of a device or user
  vouchers                    voucher batches
  vouchers new <count> [k=v]  create a batch (profile=, length=, charset=, prefix=,
                              password=same|separate, validity=, price=, ...)
                              force=1 (admin): add users beyond the capacity limit
  operators                   operator panel accounts
  operator add <user> <role>  create/update an account (role: operator|admin);
                              asks for the password on stdin
  operator del <user>         remove an account
  cert <dns-name>             create a self-signed certificate for HTTPS login
                              (use a real certificate for production)
  setup <network>             create firewall zone/rules, DHCP + server for a network
  check                       sanity checks (offloading, nftables, dnsmasq)
  flush                       log everybody out and remove the dataplane
  cleanup                     withdraw the portal from dnsmasq/odhcpd (used when disabled)
`;

let conn;

function call(method, args) {
	conn ??= ubus.connect();

	if (!conn)
		die('Cannot connect to ubus\n');

	let res = conn.call('wrthotspot', method, args ?? {});

	if (res == null)
		die(`hotspotd not responding (${ubus.error()}) - is the service running?\n`);

	return res;
}

// Every page of a paged list method.
function all(method, key) {
	let out = [];

	for (let offset = 0; ; ) {
		let r = call(method, { offset, limit: 1000 });
		push(out, ...(r[key] ?? []));
		offset += length(r[key] ?? []);

		if (!length(r[key] ?? []) || offset >= (r.total ?? 0))
			return out;
	}
}

function table(rows, cols) {
	let w = map(cols, (c) => length(c));

	for (let r in rows)
		for (let i = 0; i < length(cols); i++)
			w[i] = max(w[i], length(`${r[i] ?? ''}`));

	function line(cells) {
		let out = '';
		for (let i = 0; i < length(cols); i++)
			out += sprintf(`%-${w[i] + 2}s`, `${cells[i] ?? ''}`);
		print(rtrim(out), '\n');
	}

	line(cols);
	for (let r in rows)
		line(r);
}

function kv_args(list) {
	let out = {};

	for (let a in list) {
		let i = index(a, '=');
		if (i <= 0)
			die(`Expected key=value, got "${a}"\n`);

		let k = substr(a, 0, i), v = substr(a, i + 1);
		out[k] = (k == 'disabled' || k == 'force') ? (v == '1' || v == 'yes' || v == 'true') : v;
	}

	return out;
}

function ok(res) {
	if (res.ok === false)
		die(`Error: ${res.error}\n`);
	if (res.warning)
		warn(`Warning: ${res.warning}\n`);
	return res;
}

function setup(net) {
	let c = cursor();
	c.load('network');
	c.load('firewall');
	c.load('wrthotspot');

	if (!net || c.get('network', net) != 'interface')
		die(`No network interface "${net}" in /etc/config/network\n`);

	let zone = null;

	c.foreach('firewall', 'zone', (z) => {
		let nets = z.network;
		nets = (type(nets) == 'array') ? nets : split(nets ?? '', ' ');
		if (net in nets)
			zone = z.name;
	});

	if (zone && zone != net) {
		warn(`Note: ${net} is already in firewall zone "${zone}"; leaving that zone as is.\n`);
	}
	else if (!zone) {
		zone = net;
		let z = c.add('firewall', 'zone');
		c.set('firewall', z, 'name', zone);
		c.set('firewall', z, 'network', [ net ]);
		c.set('firewall', z, 'input', 'REJECT');
		c.set('firewall', z, 'output', 'ACCEPT');
		c.set('firewall', z, 'forward', 'REJECT');
		print(`Created firewall zone "${zone}"\n`);
	}

	// Our own zone must reach the internet, also when re-running setup.
	if (zone == net) {
		let fwd = false;
		c.foreach('firewall', 'forwarding', (f) => { if (f.src == zone && f.dest == 'wan') fwd = true; });

		if (!fwd) {
			let f = c.add('firewall', 'forwarding');
			c.set('firewall', f, 'src', zone);
			c.set('firewall', f, 'dest', 'wan');
			print(`Added forwarding ${zone} -> wan\n`);
		}
	}

	let rules = [
		{ name: 'DHCP', proto: 'udp', dest_port: '67-68', family: 'ipv4' },
		{ name: 'DHCPv6', proto: 'udp', dest_port: '547', family: 'ipv6' },
		{ name: 'ICMPv6', proto: 'icmp', family: 'ipv6',
		  icmp_type: [ 'echo-request', 'router-solicitation', 'neighbour-solicitation', 'neighbour-advertisement' ] },
		{ name: 'DNS', proto: [ 'tcp', 'udp' ], dest_port: '53' },
	];

	// The portal's ports come from the configuration (https_port is not
	// always portal_port + 1), and must follow it when setup runs again.
	let g = load_config().global;
	let want_portal = `${g.portal_port} ${g.https_port}`;
	let portal_rule = `Allow-${zone}-Portal`;
	let stale_portal = [];

	c.foreach('firewall', 'rule', (s) => {
		if (s.name == portal_rule && s.dest_port != want_portal)
			push(stale_portal, s['.name']);
	});

	for (let sid in stale_portal)
		c.delete('firewall', sid);

	push(rules, { name: 'Portal', proto: 'tcp', dest_port: want_portal });

	// A transparent proxy on the router needs its port open like the portal.
	let proxy_ports = {};
	c.foreach('wrthotspot', 'server_profile', (s) => {
		let p = (s.transparent_proxy == '1') ? parse_proxy(s.http_proxy) : null;
		if (p?.local)
			proxy_ports[p.port] = true;
	});

	let proxy_rule = `Allow-${zone}-Proxy`;
	let want_ports = join(' ', sort(keys(proxy_ports)));

	let stale = [];
	c.foreach('firewall', 'rule', (s) => {
		if (s.name == proxy_rule && s.dest_port != want_ports)
			push(stale, s['.name']);
	});

	for (let sid in stale)
		c.delete('firewall', sid);

	if (length(stale) && !length(want_ports))
		print(`Removed rule ${proxy_rule}\n`);

	if (length(want_ports))
		push(rules, { name: 'Proxy', proto: 'tcp', dest_port: want_ports });

	for (let r in rules) {
		let name = `Allow-${zone}-${r.name}`;
		let exists = false;

		c.foreach('firewall', 'rule', (s) => { if (s.name == name) exists = true; });
		if (exists)
			continue;

		let s = c.add('firewall', 'rule');
		c.set('firewall', s, 'name', name);
		c.set('firewall', s, 'src', zone);
		c.set('firewall', s, 'target', 'ACCEPT');

		for (let k, v in r)
			if (k != 'name')
				c.set('firewall', s, k, v);
	}

	// Offloaded flows bypass nftables: accounting, limits and logout would break.
	let d = null;
	c.foreach('firewall', 'defaults', (s) => { d ??= s['.name']; });
	if (d) {
		if (c.get('firewall', d, 'flow_offloading') == '1' || c.get('firewall', d, 'flow_offloading_hw') == '1')
			print('Disabled software/hardware flow offloading (incompatible with hotspot accounting)\n');

		c.set('firewall', d, 'flow_offloading', '0');
		c.set('firewall', d, 'flow_offloading_hw', '0');
	}

	if (c.get('wrthotspot', net) != 'server') {
		c.set('wrthotspot', net, 'server');
		c.set('wrthotspot', net, 'interface', net);
		c.set('wrthotspot', net, 'profile', 'default');
		c.set('wrthotspot', net, 'idle_timeout', '5m');
		print(`Created hotspot server "${net}"\n`);
	}

	// Clients need addresses: DHCPv4 plus RA/DHCPv6 for IPv6.
	c.load('dhcp');
	let have_dhcp = false;
	c.foreach('dhcp', 'dhcp', (s) => { if (s.interface == net) have_dhcp = true; });

	if (!have_dhcp && c.get('network', net, 'proto') == 'static') {
		c.set('dhcp', net, 'dhcp');
		c.set('dhcp', net, 'interface', net);
		c.set('dhcp', net, 'start', '10');
		c.set('dhcp', net, 'limit', '240');
		c.set('dhcp', net, 'leasetime', '1h');
		c.set('dhcp', net, 'ra', 'server');
		c.set('dhcp', net, 'dhcpv6', 'server');
		c.set('dhcp', net, 'ra_flags', [ 'managed-config', 'other-config' ]);
		c.save('dhcp');
		c.commit('dhcp');
		print(`Created DHCP/RA/DHCPv6 service for "${net}"\n`);
	}

	c.save('firewall');
	c.save('wrthotspot');
	c.commit('firewall');
	c.commit('wrthotspot');

	print('Done. Apply with:\n  service network reload && service firewall reload && service dnsmasq restart && service odhcpd restart && service wrthotspot restart\n');
}

// Self-signed certificate for HTTPS login; browsers will warn, so use a real
// certificate (e.g. via acme) for production.
function make_cert(name) {
	if (!name || !match(name, /^[A-Za-z0-9.-]+$/))
		die('Usage: wrthotspot cert <dns-name>\n');

	let dir = '/etc/wrthotspot';
	let crt = `${dir}/portal.crt`, key = `${dir}/portal.key`;

	run(`mkdir -p ${dir}`);

	let r = run(`px5g selfsigned -days 3650 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -keyout ${key} -out ${crt} -subj /CN=${name}`);

	if (r.code != 0)
		die(`px5g failed: ${r.out}\n`);

	let c = cursor();
	c.load('wrthotspot');
	c.set('wrthotspot', 'global', 'ssl_certificate', crt);
	c.set('wrthotspot', 'global', 'ssl_key', key);
	c.save('wrthotspot');
	c.commit('wrthotspot');

	print(`Wrote ${crt} and ${key} for ${name}.\nSet the server profile's dns_name to ${name}, add 'https' to login_by, then: service wrthotspot reload\n`);
}

function check() {
	conn ??= ubus.connect();

	let st = conn ? conn.call('wrthotspot', 'status') : null;
	let checks = run_checks(load_config(), st ? { running: true, ...st } : { running: false });
	let bad = 0;

	for (let c in checks) {
		print(sprintf('  %-6s %s
', (c.level == 'ok') ? 'ok' : uc(c.level), c.message));

		if (c.level == 'error')
			bad++;
	}

	exit(bad ? 1 : 0);
}

let args = ARGV;
let cmd = shift(args);

switch (cmd) {
case 'status':
	let st = call('status');
	print(`hotspotd ${st.version}: ${st.sessions} session(s), ${st.hosts} host(s), ${st.users} user(s)\n`);
	let cp = st.capacity;
	if (cp && cp.mode != 'off')
		print(`  capacity: ${cp.tier?.label} RAM tier, ${cp.mode} mode: ${cp.sessions}/${cp.max_sessions} sessions, ` +
			`${cp.users}/${cp.max_users} user accounts${cp.override ? ' (override on)' : ''}\n`);
	print(`  RADIUS: ${st.radius ? 'installed' : 'not installed (local users only)'}\n`);
	for (let dev, srv in st.devices)
		print(`  server ${srv} on ${dev}\n`);
	break;

case 'sessions':
	table(map(all('sessions', 'sessions'), (s) => [
		s.user, s.mac, join(',', s.ipv4), length(s.ipv6) ? `${length(s.ipv6)} addr` : '-',
		s.server, s.login_by, s.uptime_text, fmt_bytes(s.bytes_in), fmt_bytes(s.bytes_out), s.id,
	]), [ 'USER', 'MAC', 'IPV4', 'IPV6', 'SERVER', 'BY', 'UPTIME', 'IN', 'OUT', 'ID' ]);
	break;

case 'hosts':
	table(map(all('hosts', 'hosts'), (h) => [
		h.mac, h.authorized ? 'A' : '-', h.server, h.dev, join(',', h.ipv4), join(' ', h.ipv6),
	]), [ 'MAC', 'AUTH', 'SERVER', 'DEV', 'IPV4', 'IPV6' ]);
	break;

case 'users':
	table(map(all('user_list', 'users'), (u) => [
		u.name, u.profile, u.server, u.mac || '-', u.disabled ? 'X' : '',
		fmt_duration(u.used?.uptime), fmt_bytes(u.used?.bytes_in), fmt_bytes(u.used?.bytes_out), u.comment,
	]), [ 'NAME', 'PROFILE', 'SERVER', 'MAC', 'DIS', 'UPTIME', 'IN', 'OUT', 'COMMENT' ]);
	break;

case 'user':
	let sub = shift(args), name = shift(args);

	if (!name)
		die(USAGE);

	if (sub == 'add' || sub == 'set')
		ok(call('user_set', { name, ...kv_args(args) }));
	else if (sub == 'del' || sub == 'remove')
		ok(call('user_remove', { name }));
	else if (sub == 'reset')
		ok(call('user_reset_counters', { name }));
	else
		die(USAGE);
	break;

case 'logout':
	let sel = shift(args);

	if (!sel)
		die(USAGE);

	let a = match(sel, /^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$/) ? { mac: sel }
		: match(sel, /^[0-9.]+$|:/) ? { ip: sel }
		: match(sel, /^[0-9a-f]{8}$/) ? { id: sel }
		: { user: sel };

	print(`Logged out ${ok(call('logout', { ...a, cause: 'admin-reset' })).count} session(s)\n`);
	break;

case 'cookies':
	let ck = call('cookies');
	table([
		...map(ck.cookies, (c) => [ 'http', c.user, c.mac, fmt_duration(c.expires_in) ]),
		...map(ck.mac_cookies, (c) => [ 'mac', c.user, c.mac, fmt_duration(c.expires_in) ]),
	], [ 'TYPE', 'USER', 'MAC', 'EXPIRES IN' ]);
	break;

case 'cookie':
	let csub = shift(args), csel = shift(args);

	if (csub != 'del' || !csel)
		die(USAGE);

	let cargs = match(csel, /^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$/) ? { mac: csel } : { user: csel };
	print(`Removed ${ok(call('cookie_remove', cargs)).count} cookie(s)\n`);
	break;

case 'vouchers':
	if (args[0] == 'new') {
		shift(args);
		let count = int(shift(args) ?? 0);
		let opts = kv_args(args);

		for (let k in [ 'length', 'password_length' ])
			if (exists(opts, k))
				opts[k] = int(opts[k]);

		let r = ok(call('voucher_create', { count, ...opts }));

		print(`Batch ${r.batch}:\n`);
		for (let v in r.vouchers)
			print((v.password == v.name) ? `  ${v.name}\n` : `  ${v.name}  ${v.password}\n`);
		break;
	}

	table(map(call('voucher_batches').batches, (b) => [
		b.batch, b.profile, `${b.count}`, `${b.used}`, b.validity ? fmt_duration(b.validity) : '-', b.price || '-', b.created_by, b.comment,
	]), [ 'BATCH', 'PROFILE', 'COUNT', 'USED', 'VALID', 'PRICE', 'BY', 'NOTE' ]);
	break;

case 'operators':
	table(map(call('operator_list').operators, (o) => [ o.username, o.role, o.comment ]), [ 'USER', 'ROLE', 'NOTE' ]);
	break;

case 'operator':
	let osub = shift(args), ouser = shift(args);

	if (osub == 'add' || osub == 'set') {
		let role = shift(args) ?? 'operator';
		printf('Password for %s (empty keeps the current one): ', ouser);
		let pw = rtrim(fs.stdin.read('line') ?? '', '\r\n');
		print('\n');
		ok(call('operator_set', { username: ouser, password: pw, role }));
		print(`Operator ${ouser} saved; the panel is at http://<router>/hotspot/\n`);
	}
	else if (osub == 'del' || osub == 'remove') {
		ok(call('operator_remove', { username: ouser }));
	}
	else {
		die(USAGE);
	}
	break;

case 'cert':
	make_cert(shift(args));
	break;

case 'setup':
	setup(shift(args));
	break;

case 'check':
	check();
	break;

case 'flush':
	ok(call('flush'));
	print('All sessions logged out, dataplane removed\n');
	break;

// The service is disabled: clients must no longer be told about a portal
// (DHCP option 114, RA captive_portal_uri, nftset lines for a missing table).
case 'cleanup':
	let d = remove_dnsmasq(true), o = remove_odhcpd(true);
	print(`dnsmasq: ${d ? 'portal settings removed' : 'nothing to remove'}, odhcpd: ${o ? 'portal URI removed' : 'nothing to remove'}\n`);
	break;

default:
	print(USAGE);
	exit(cmd ? 1 : 0);
}

// DNS/DHCP side of the hotspot:
//  - dnsmasq snippet: portal name -> router address (interface-name=),
//    walled-garden domains -> nftables sets (nftset=, needs dnsmasq-full),
//    RFC 8910 captive-portal URI in DHCPv4 option 114
//  - odhcpd: RFC 8910 URI for RA/DHCPv6 (captive_portal_uri, odhcpd 2026+)
//  - a resolver that keeps walled-garden host sets filled on any dnsmasq
//    build (the stock one has no nftset support)
'use strict';

import * as fs from 'fs';
import * as uloop from 'uloop';
import { cursor } from 'uci';
import { run, log, write_atomic } from 'wrthotspot.util';
import { wg_refresh_cmds } from 'wrthotspot.nft';

const SNIPPET = 'wrthotspot.conf';

let has_nftset = null;

export function dnsmasq_has_nftset() {
	if (has_nftset == null) {
		let out = run('dnsmasq -v').out ?? '';
		has_nftset = !!match(out, / nftset/) && !match(out, /no-nftset/);
	}

	return has_nftset;
};

// conf-dir of every running dnsmasq instance (OpenWrt names them per instance).
function conf_dirs() {
	let dirs = {};

	for (let f in filter(fs.lsdir('/var/etc') ?? [], (n) => substr(n, 0, 13) == 'dnsmasq.conf.')) {
		f = `/var/etc/${f}`;

		for (let line in split(fs.readfile(f) ?? '', '\n')) {
			let m = match(line, /^conf-dir=([^,]+)/);
			if (m)
				dirs[m[1]] = true;
		}
	}

	if (!length(keys(dirs)))
		dirs['/tmp/dnsmasq.d'] = true;

	return keys(dirs);
}

// The DHCP section serving a network, e.g. "lan" -> dhcp.lan.
function dhcp_section(c, network) {
	let name = null;

	c.foreach('dhcp', 'dhcp', (s) => {
		if (s.interface == network && !name)
			name = s['.name'];
	});

	return name;
}

// https://<dns_name>:<port>/api/captive, or null when HTTPS isn't usable
// (RFC 8908 requires HTTPS for the API).
export function captive_api_url(cfg, sp) {
	let g = cfg.global;

	if (!sp?.rfc8910 || !sp.dns_name || !g.ssl_certificate || !fs.stat(g.ssl_certificate) || !fs.stat(g.ssl_key))
		return null;

	return `https://${sp.dns_name}${(g.https_port == 443) ? '' : `:${g.https_port}`}/api/captive`;
};

export function snippet(cfg, devices) {
	let lines = [ '# Generated by hotspotd - do not edit' ];
	let c = cursor();
	c.load('dhcp');

	for (let dev, server in devices) {
		let srv = cfg.servers[server];
		let sp = cfg.server_profiles[srv?.profile] ?? cfg.server_profiles.default;

		if (sp.dns_name)
			push(lines, `interface-name=${sp.dns_name},${dev}`);

		let url = captive_api_url(cfg, sp);
		let tag = srv?.interface ? dhcp_section(c, srv.interface) : null;

		if (url && tag)
			push(lines, `dhcp-option-force=tag:${tag},114,"${url}"`);
	}

	if (dnsmasq_has_nftset()) {
		for (let e in cfg.walled_garden)
			if (e.host)
				push(lines, `nftset=/${e.host}/4#inet#wrthotspot#wgh${e.idx}_4,6#inet#wrthotspot#wgh${e.idx}_6`);
	}

	return join('\n', lines) + '\n';
};

// Write the snippet into every dnsmasq conf-dir; restart dnsmasq if it changed.
export function apply_dnsmasq(cfg, devices) {
	let text = snippet(cfg, devices);
	let changed = false;

	for (let dir in conf_dirs()) {
		let path = `${dir}/${SNIPPET}`;

		if (fs.readfile(path) === text)
			continue;

		if (!fs.stat(dir))
			fs.mkdir(dir, 0o755);

		write_atomic(path, text);
		changed = true;
	}

	if (changed) {
		log('info', 'dnsmasq configuration changed, restarting dnsmasq');
		uloop.process('/etc/init.d/dnsmasq', [ 'restart' ], {}, () => {});
	}

	return changed;
};

export function remove_dnsmasq() {
	let changed = false;

	for (let dir in conf_dirs()) {
		if (fs.unlink(`${dir}/${SNIPPET}`))
			changed = true;
	}

	if (changed)
		uloop.process('/etc/init.d/dnsmasq', [ 'restart' ], {}, () => {});
};

// odhcpd announces the RFC 8910 URI in RAs and DHCPv6 (and DHCPv4 where it
// serves it). Only touch values we own: ours always end in /api/captive.
export function apply_odhcpd(cfg) {
	let c = cursor();
	c.load('dhcp');
	let changed = false;

	for (let name, srv in cfg.servers) {
		let sec = srv.interface ? dhcp_section(c, srv.interface) : null;

		if (!sec)
			continue;

		let sp = cfg.server_profiles[srv.profile] ?? cfg.server_profiles.default;
		let want = captive_api_url(cfg, sp);
		let have = c.get('dhcp', sec, 'captive_portal_uri');

		if (want && have != want) {
			c.set('dhcp', sec, 'captive_portal_uri', want);
			changed = true;
		}
		else if (!want && have && match(have, /\/api\/captive$/)) {
			c.delete('dhcp', sec, 'captive_portal_uri');
			changed = true;
		}
	}

	if (changed) {
		c.save('dhcp');
		c.commit('dhcp');
		uloop.process('/etc/init.d/odhcpd', [ 'reload' ], {}, () => {});
	}

	return changed;
};

function parse_nslookup(text) {
	let v4 = {}, v6 = {};
	let in_answer = false;

	for (let line in split(text ?? '', '\n')) {
		if (match(line, /^Name:/))
			in_answer = true;

		let m = in_answer ? match(line, /^Address( [0-9]+)?:[[:space:]]+([^[:space:]]+)$/) : null;
		let a = m ? iptoarr(m[2]) : null;

		if (a)
			((length(a) == 16) ? v6 : v4)[arrtoip(a)] = true;
	}

	return { v4: keys(v4), v6: keys(v6) };
}

export { parse_nslookup };

// Resolve every walled-garden host through the local dnsmasq (which, when it
// supports nftset, fills the sets as a side effect) and refresh the sets
// ourselves. Runs asynchronously; `exec(cmds)` applies nft commands.
export function resolve_walled_garden(cfg, state_dir, exec) {
	for (let e in cfg.walled_garden) {
		if (!e.host)
			continue;

		let out = `${state_dir}/resolve.${e.idx}`;
		let host = e.host, idx = e.idx, ttl = cfg.global.walled_garden_ttl;

		uloop.process('/bin/sh', [ '-c', `nslookup '${host}' 127.0.0.1 > '${out}' 2>&1` ], {}, () => {
			let res = parse_nslookup(fs.readfile(out));
			fs.unlink(out);

			let cmds = [ ...wg_refresh_cmds(idx, 4, res.v4, ttl), ...wg_refresh_cmds(idx, 6, res.v6, ttl) ];

			if (length(cmds))
				exec(cmds);
			else
				log('debug', 'Walled garden host %s did not resolve', host);
		});
	}
};


config global 'global'
	option enabled '1'
	# Seconds between counter reads / timeout checks.
	option poll_interval '10s'
	option portal_port '8002'
	# HTTPS portal (login_by https, RFC 8908/8910). `wrthotspot cert <name>`
	# creates a self-signed pair; use a real certificate in production.
	#option https_port '8003'
	#option ssl_certificate '/etc/wrthotspot/portal.crt'
	#option ssl_key '/etc/wrthotspot/portal.key'
	option state_dir '/tmp/wrthotspot'
	option db_dir '/etc/wrthotspot'
	# How often user usage counters and cookies are written to flash.
	option db_sync_interval '5m'
	# Walled-garden hosts: re-resolve interval and how long addresses stay.
	option resolve_interval '5m'
	option walled_garden_ttl '1h'
	option log_level 'info'
	# NAS-Identifier sent to RADIUS.
	option nas_identifier 'WrtHotspot'
	# RFC 5176 CoA / Disconnect listener (0 = off). For a RADIUS server
	# outside the router, allow udp/3799 from it in the firewall.
	option coa_port '3799'
	# Rate limits: auto = tc HTB when wrt-hotspot-shaper is installed,
	# otherwise nftables policing; or force 'tc', 'nft', 'off'.
	option shaper 'auto'
	# Root rate of the HTB trees; keep it above the real link speed.
	option shaper_capacity '10G'

# RADIUS servers, tried in order. Used by server profiles with use_radius.
#config radius 'main'
#	option address '192.0.2.10'

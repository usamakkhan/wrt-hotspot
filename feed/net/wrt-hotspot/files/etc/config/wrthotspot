config global 'global'
	option enabled '1'
	# Seconds between counter reads / timeout checks.
	option poll_interval '10s'
	option portal_port '8002'
	# HTTPS portal (login_by https, RFC 8908/8910). `wrthotspot cert <name>`
	# creates a self-signed pair; use a real certificate in production.
	#option https_port '8003'
	#option ssl_certificate '/etc/wrthotspot/portal.crt'
	#option ssl_key '/etc/wrthotspot/portal.key'
	option state_dir '/tmp/wrthotspot'
	option db_dir '/etc/wrthotspot'
	# How often user usage counters and cookies are written to flash.
	option db_sync_interval '5m'
	# Walled-garden hosts: re-resolve interval and how long addresses stay.
	option resolve_interval '5m'
	option walled_garden_ttl '1h'
	option log_level 'info'
	option nas_identifier 'WrtHotspot'

# One server per hotspot network (created by `wrthotspot setup <network>`).
#config server 'hotspot'
#	option interface 'hotspot'
#	option profile 'default'
#	option idle_timeout '5m'

config server_profile
	option name 'default'
	# Portal host name; resolves to the router on each hotspot network.
	option dns_name ''
	# mac, cookie, http-chap, http-pap, https, trial, mac-cookie
	list login_by 'http-chap'
	list login_by 'http-pap'
	list login_by 'cookie'
	option http_cookie_lifetime '3d'
	option html_directory '/usr/share/wrthotspot/pages/default'
	option trial_uptime_limit '30m'
	option trial_uptime_reset '1d'
	option trial_user_profile 'default'
	# Announce the RFC 8908 API in DHCP/RA (needs dns_name + certificate).
	option rfc8910 '1'

config user_profile
	option name 'default'
	option shared_users '1'
	option session_timeout '0'
	option idle_timeout '0'
	option keepalive_timeout '2m'
	option status_autorefresh '1m'
	option add_mac_cookie '1'
	option mac_cookie_timeout '3d'


#	option require_message_auth '1'

# One server per hotspot network (created by `wrthotspot setup <network>`).
#config server 'hotspot'
#	option interface 'hotspot'
#	option profile 'default'
#	option idle_timeout '5m'

config server_profile
	option name 'default'
	# Portal host name; resolves to the router on each hotspot network.
	option dns_name ''
	# mac, cookie, http-chap, http-pap, https, trial, mac-cookie
	list login_by 'http-chap'
	list login_by 'http-pap'
	list login_by 'cookie'
	option http_cookie_lifetime '3d'
	option html_directory '/usr/share/wrthotspot/pages/default'
	option trial_uptime_limit '30m'
	option trial_uptime_reset '1d'
	option trial_user_profile 'default'
	# Announce the RFC 8908 API in DHCP/RA (needs dns_name + certificate).
	option rfc8910 '1'
	# RADIUS: local users are checked first, unknown users go to RADIUS.
	option use_radius '0'
	option radius_accounting '1'
	# 'received' = Acct-Interim-Interval from the server, or a duration.
	option radius_interim_update 'received'
	option radius_mac_format 'XX:XX:XX:XX:XX:XX'
	option nas_port_type 'wireless-802.11'
	#option radius_location_id 'isocc=us,cc=1,ac=408,network=ACMEWISP_NewarkAirport'
	#option radius_location_name 'Lobby'
	#option mac_auth_password ''

config user_profile
	option name 'default'
	option shared_users '1'
	option session_timeout '0'
	option idle_timeout '0'
	option keepalive_timeout '2m'
	option status_autorefresh '1m'
	option add_mac_cookie '1'
	option mac_cookie_timeout '3d'
	# MikroTik syntax, rx = upload, tx = download (bits/s, k/M/G):
	# rx/tx [rx-burst/tx-burst [rx-threshold/tx-threshold [rx-time/tx-time [priority [rx-min/tx-min]]]]]
	#option rate_limit '2M/10M 4M/20M 1500k/7M 16/16 8 512k/2M'
	#list limitation 'office'


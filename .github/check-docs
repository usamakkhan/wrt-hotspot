#!/usr/bin/env python3
"""Check local Markdown links, heading anchors, and fenced code blocks."""

from __future__ import annotations

import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path
from urllib.parse import unquote, urlsplit


ROOT = Path(__file__).resolve().parents[1]
LINK = re.compile(r"!?\[[^\]]*\]\((<[^>]+>|[^)]+)\)")
HEADING = re.compile(r"^ {0,3}#{1,6}\s+(.+?)\s*#*\s*$")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
EXPLICIT_ANCHOR = re.compile(r'<a\s+(?:id|name)=["\']([^"\']+)["\']', re.I)
REPO_ANCHOR = re.compile(r"https://github\.com/(?:usamakkhan/wrt-hotspot|\$REPO)#([a-z0-9-]+)")


def slug(title: str) -> str:
    title = re.sub(r"\[([^]]+)\]\([^)]+\)", r"\1", title)
    title = re.sub(r"<[^>]+>", "", title)
    title = title.replace("`", "").lower()
    title = re.sub(r"[^\w\s-]", "", title, flags=re.UNICODE)
    return re.sub(r"\s", "-", title)


def markdown_files() -> list[Path]:
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "*.md"],
        cwd=ROOT, check=True, capture_output=True,
    )
    return sorted({ROOT / name.decode() for name in result.stdout.split(b"\0") if name})


def parse(path: Path) -> tuple[set[str], list[tuple[int, str]], list[str]]:
    anchors: set[str] = set()
    links: list[tuple[int, str]] = []
    errors: list[str] = []
    occurrences: dict[str, int] = defaultdict(int)
    fence_char = ""
    fence_size = 0
    fence_line = 0

    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        marker = FENCE.match(line)
        if marker:
            run = marker.group(1)
            if not fence_char:
                fence_char, fence_size, fence_line = run[0], len(run), number
            elif run[0] == fence_char and len(run) >= fence_size:
                fence_char, fence_size = "", 0
            continue
        if fence_char:
            continue

        for anchor in EXPLICIT_ANCHOR.findall(line):
            anchors.add(anchor)
        heading = HEADING.match(line)
        if heading:
            base = slug(heading.group(1))
            count = occurrences[base]
            anchors.add(f"{base}-{count}" if count else base)
            occurrences[base] += 1
        for match in LINK.finditer(line):
            target = match.group(1).strip("<>").split(maxsplit=1)[0]
            links.append((number, target))

    if fence_char:
        errors.append(f"{path.relative_to(ROOT)}:{fence_line}: unclosed code fence")
    return anchors, links, errors


def main() -> int:
    files = markdown_files()
    parsed = {path: parse(path) for path in files}
    errors = [error for _, _, file_errors in parsed.values() for error in file_errors]

    for source, (_, links, _) in parsed.items():
        for number, target in links:
            if target.startswith(("mailto:", "tel:")):
                continue
            parts = urlsplit(target)
            if parts.scheme or parts.netloc:
                continue  # external URLs are outside this local check
            destination = (source.parent / unquote(parts.path)).resolve() if parts.path else source
            location = f"{source.relative_to(ROOT)}:{number}"
            if not destination.is_file():
                errors.append(f"{location}: missing local file {target}")
            elif parts.fragment and destination.suffix.lower() == ".md":
                anchors = parsed.get(destination)
                if anchors is None:
                    anchors = parse(destination)
                if unquote(parts.fragment) not in anchors[0]:
                    errors.append(f"{location}: missing heading #{parts.fragment} in {destination.relative_to(ROOT)}")

    # The LuCI page selector, sample-page README and release script link to
    # README headings with repository URLs rather than relative Markdown links.
    source_files = subprocess.run(
        ["git", "ls-files", "-z", "--", "feed", "scripts"],
        cwd=ROOT, check=True, capture_output=True,
    )
    readme_anchors = parsed[ROOT / "README.md"][0]
    for name in (item.decode() for item in source_files.stdout.split(b"\0") if item):
        source = ROOT / name
        if source.suffix not in {".js", ".txt", ".sh"}:
            continue
        for number, line in enumerate(source.read_text(encoding="utf-8").splitlines(), 1):
            for anchor in REPO_ANCHOR.findall(line):
                if anchor not in readme_anchors:
                    errors.append(f"{name}:{number}: missing README heading #{anchor}")

    for error in errors:
        print(error, file=sys.stderr)
    if errors:
        return 1
    print(f"Checked {len(files)} Markdown files: local links, anchors and code fences OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
